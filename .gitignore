# Files git never tracks: environments, caches, and everything the pipeline generates
# (data, artefacts and reports are rebuilt by `bluff all` or versioned with DVC).
# environments
.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
.ruff_cache/

# generated data and models (tracked with DVC, not git)
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
artefacts/*
!artefacts/.gitkeep
# The submitted run's trained detectors and registry are kept in git (small, ~6 MB), and so is
# the M2 adapter (74 MB, under GitHub's 100 MB file limit) so M2 runs without Hugging Face.
# Everything is also in the Hugging Face dataset repo (docs/where-things-are.md).
!artefacts/m0_base/
!artefacts/m1_rag/
!artefacts/m2_qlora/
!artefacts/m3_rag_qlora/
!artefacts/registry/
!artefacts/adapters/
artefacts/adapters/*
!artefacts/adapters/m2_qlora/
reports/*
data/datasets/*
!data/datasets/.gitkeep
!reports/.gitkeep
# The submitted results: metrics, per-question scores, summaries and charts.
!reports/m0_base/
!reports/m1_rag/
!reports/m2_qlora/
!reports/m3_rag_qlora/
!reports/compare/
!reports/results_figures/
!reports/results_summary.json
mlruns/
logs/
mlflow.db

# packaging and OS noise
*.egg-info/
build/
dist/
.DS_Store
Thumbs.db
