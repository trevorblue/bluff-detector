# Files git never tracks: environments, caches, and everything the pipeline generates
# (data, artefacts and reports are rebuilt by `bluff all` or versioned with DVC).
# environments
.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
.ruff_cache/

# generated data and models (tracked with DVC, not git)
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
artefacts/*
!artefacts/.gitkeep
# The submitted run's trained detectors and registry are kept in git (small, ~6 MB). The M2
# adapter (~70 MB) and other runs stay out; they are in the Hugging Face dataset repo.
!artefacts/m0_base/
!artefacts/m1_rag/
!artefacts/m2_qlora/
!artefacts/registry/
reports/*
data/datasets/*
!data/datasets/.gitkeep
!reports/.gitkeep
# The submitted results: metrics, per-question scores, summaries and charts.
!reports/m0_base/
!reports/m1_rag/
!reports/m2_qlora/
!reports/compare/
!reports/results_figures/
mlruns/
logs/
mlflow.db

# packaging and OS noise
*.egg-info/
build/
dist/
.DS_Store
Thumbs.db
